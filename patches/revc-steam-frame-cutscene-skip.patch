+}
+
+bool
+CCutsceneMgr::CanSkipCutscene(void)
+{
+	// The finale and cameras without a loaded flyby spline have no native
+	// endpoint to hand off to. Keep Frame's hold on this same readiness gate.
+	return ms_running && ms_loaded && bCamLoaded && !HasCutsceneFinished() &&
+		CGeneral::faststricmp(ms_cutsceneName, "finale") &&
+		TheCamera.Cams[TheCamera.ActiveCam].Mode == CCam::MODE_FLYBY &&
+		ms_cutsceneLoadStatus == 0;
 }

 bool CCutsceneMgr::HasCutsceneFinished(void) { return !bCamLoaded || TheCamera.GetPositionAlongSpline() == 1.0f; }
