<?xml version="1.0" encoding="utf-8"?>
<!--
	Merged over src/main for the "frame" build type: the Valve Steam Frame, whose
	Android container (Lepton, Android 11) runs the app on SteamVR's OpenXR
	runtime. What the Quest manifest declares and the Frame must not (or need not):
	Horizon OS shell metadata, and a hard install-time
	requirement on the headtracking feature, which the container may not advertise.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools">

	<uses-feature
		android:name="android.hardware.vr.headtracking"
		android:required="false"
		tools:replace="android:required" />

	<!--
		Game data, settings, saves and VR diagnostics live in
		/sdcard/Documents/ViceCityVR, the headset's ~/Documents/ViceCityVR, which
		survives Lepton resets. Lepton makes /sdcard/Documents a symlink to the host
		folder, so plain file permissions decide there; the grant is declared in
		case a later Lepton enforces Android's storage rules. The native side falls
		back to the app's external files dir, with a log line, if the folder cannot
		be written.
	-->
	<uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

	<application android:requestLegacyExternalStorage="true">
		<activity android:name="android.app.NativeActivity">
			<!-- The Meta store category in the launcher filter stays; Lepton
			     ignores it. -->
			<meta-data
				android:name="com.oculus.vr.focusaware"
				tools:node="remove" />
		</activity>
	</application>
</manifest>
